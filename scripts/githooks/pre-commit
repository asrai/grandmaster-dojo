#!/bin/sh
# gitleaks pre-commit hook (git-native, non-Node / non-Python stack)
#
# 소비 저장소에서 파일 위치:
#   scripts/githooks/pre-commit
#
# 활성화 경로 (클론한 머신에서 1회):
#   ./scripts/setup-githooks.sh
#   → git config --local core.hooksPath scripts/githooks 를 세팅해 이 파일이
#     .git/hooks/pre-commit 대신 pre-commit 훅으로 실행됨.
#
# 사용처:
#   husky 도 pre-commit framework 도 쓰지 않는 저장소.
#   대표 예: Godot / Unity 등 게임 엔진 저장소 (Node/Python 런타임 부담 회피).
#
# 설계 의도:
#   - 3-layer secret defense 의 layer 1 (로컬 커밋 시점 차단) 을 엔진 런타임
#     의존 없이 순수 git + gitleaks 로 구현.
#   - gitleaks 미설치 머신에서는 commit 을 막지 않고 경고만 출력. 머신 전환
#     직후 brew install 누락이 전체 작업을 블록하지 않도록 함.
#
# gitleaks v8.18+ 기준:
#   - `gitleaks git --staged` 가 권장. 이전 `gitleaks protect` 는 deprecated.
#   - `--redact` 는 발견된 시크릿 값을 로그에서 가림 (화면 공유 시 2차 유출 방지).
#   - `--no-banner` 는 CI-친화적 출력.

if command -v gitleaks >/dev/null 2>&1; then
    gitleaks git --staged --redact --verbose --no-banner || {
        echo ""
        echo "gitleaks 가 커밋에서 시크릿 패턴을 발견했습니다."
        echo "위 --redact 출력의 파일/라인을 확인하고 제거한 뒤 다시 커밋하세요."
        echo "false positive 인 경우 .gitleaks.toml 의 [allowlist] 로 예외 처리 가능."
        exit 1
    }
else
    echo "gitleaks 미설치 — brew install gitleaks 후 재시도 권장 (지금 커밋은 진행)"
fi
